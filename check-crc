#!/usr/bin/env python3

import argparse, json, os, re, sys, urllib.request, zlib

def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={'Accept': 'application/json'})
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except Exception:
        return {}

def crc32(path):
    prev = 0
    try:
        with open(path, 'rb') as f:
            while chunk := f.read(1024 * 1024):
                prev = zlib.crc32(chunk, prev)
        return f"{prev & 0xFFFFFFFF:08X}"
    except Exception:
        return None

def search_releases(base, ext, folder=None):
    queries = [f"r:{base}"]
    if folder:
        queries.append(f"r:{folder}")

    lc = base.lower()
    if ext.lower() == ".iso":
        sample_variants = [
            f"{lc}.sample.m2ts",
            f"{lc}-sample.m2ts",
            f"sample-{lc}.m2ts",
            f"sample.{lc}.m2ts",
        ]
    else:
        sample_variants = [
            f"{lc}.sample{ext}",
            f"{lc}-sample{ext}",
            f"sample-{lc}{ext}",
            f"sample.{lc}{ext}",
        ]
    queries.extend(f"store-real-filename:{v}" for v in sample_variants)

    for q in queries:
        res = fetch_json(f"https://api.srrdb.com/v1/search/{q}")
        releases = [r.get('release') for r in res.get('results', []) if 'release' in r]
        if releases:
            return releases
    return []

def fetch_file_details(rel, name, base):
    data = fetch_json(f"https://api.srrdb.com/v1/details/{rel}")
    archived = data.get('archived-files', [])
    for f in archived:
        fname = os.path.basename(f.get('name'))
        if fname.lower() == name.lower():
            return f
    if len(archived) == 1:
        rel_lc = rel.lower()
        if rel_lc == name.lower() or rel_lc == base.lower():
            return archived[0]
    return None

def handle_match(path, name, original_name, rename=False):
    print("OK", end='')
    if original_name != name:
        if rename:
            os.rename(path, os.path.join(os.path.dirname(path), original_name))
            print(f" (RENAMED -> {original_name})", end='')
        else:
            print(f" (ORIGINAL NAME: {original_name})", end='')
    print()

def check_file(path, folder=None, rename=False):
    name = os.path.basename(path)
    base, ext = os.path.splitext(name)
    base = re.sub(r" \([0-9]+\)$", "", base)
    search_name = base + ext
    print(f"{name} ... ", end='', flush=True)

    releases = search_releases(base, ext, folder)
    if not releases:
        return print("RELEASE NOT FOUND")

    size = None
    crc = None
    for release in dict.fromkeys(releases):
        file_details = fetch_file_details(release, search_name, base)
        if not file_details:
            continue
        expected_size = file_details.get('size')
        if expected_size is not None:
            if size is None:
                try:
                    size = os.path.getsize(path)
                except Exception:
                    return print("ERR")
            if size != expected_size:
                return print(f"MISMATCH (local size: {size}, original size: {expected_size})")
        if crc is None:
            crc = crc32(path)
            if not crc:
                return print("ERR")
        if crc == file_details.get('crc'):
            original_name = os.path.basename(file_details.get('name') or name)
            return handle_match(path, name, original_name, rename)
        return print(f"MISMATCH (local: {crc}, original: {file_details.get('crc')})")

    print("RELEASE NOT FOUND")


def ignore_file(dir_path, fname):
    if fname.startswith('.'):
        return True
    full = os.path.join(dir_path, fname)
    if not os.path.isfile(full):
        return True
    if fname.lower().endswith(('.nfo', '.sfv', '.srr', '.nzb')):
        return True
    base = os.path.splitext(fname)[0].lower()
    return base.startswith('sample') or base.endswith('sample')

def main():
    parser = argparse.ArgumentParser(description="Check CRC against srrdb and optionally rename to original filename")
    parser.add_argument('path', help='File or directory to check')
    parser.add_argument('--rename', action='store_true', help='Rename the file to the original name when CRC matches')
    args = parser.parse_args()

    p = args.path
    if os.path.isfile(p):
        return check_file(p, rename=args.rename)

    if os.path.isdir(p):
        files = [f for f in os.listdir(p) if not ignore_file(p, f)]
        files.sort(key=str.lower)
        folder_name = os.path.basename(os.path.abspath(p)) if len(files) == 1 else None
        for f in files:
            check_file(os.path.join(p, f), folder_name, args.rename)
        return

    print(f"Error: {p} not found")

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nAborted")
        sys.exit(1)
